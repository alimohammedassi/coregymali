<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash v21+ — same as drawable/launch_background but with
     ?android:colorBackground fallback overridden to solid #121310 via colors.
     Keeps static PNG centered before engine starts. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_static" />
    </item>
</layer-list>
