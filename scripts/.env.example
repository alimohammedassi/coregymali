# Copy this file to scripts/.env and fill in your real values
# NEVER commit scripts/.env to git

# Your Supabase project URL (from Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key (Settings > API > service_role) — has full DB access, keep secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key

# Free Pexels API key from https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
